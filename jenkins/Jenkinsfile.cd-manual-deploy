pipeline {

    agent any

    stages {

        stage('Deploy') {

            steps {

                script {

                    if (params.ENVIRONMENT == 'main') {

                        sh """
                            echo "Deploying MAIN environment"
                            echo "Image: nodemain:${params.IMAGE_TAG}"

                            docker stop nodemain-container 
                            docker rm nodemain-container 

                            docker run -d \
                                --name nodemain-container \
                                --expose 3000 \
                                -p 3000:3000 \
                                nodemain:${params.IMAGE_TAG}
                        """

                    }

                    else if (params.ENVIRONMENT == 'dev') {

                        sh """
                            echo "Deploying DEV environment"
                            echo "Image: nodedev:${params.IMAGE_TAG}"

                            docker stop nodedev-container 
                            docker rm nodedev-container 

                            docker run -d \
                                --name nodedev-container \
                                --expose 3001 \
                                -p 3001:3000 \
                                nodedev:${params.IMAGE_TAG}
                        """

                    }
                }
            }
        }
    }
}