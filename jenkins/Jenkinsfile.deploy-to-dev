pipeline {

    agent any

    stages {

        stage('Pull Image') {
            steps {
                sh 'docker pull muratbekov3/nodedev:v1.0'
            }
        }

        stage('Deploy Dev') {
            steps {
                sh '''
                    docker stop nodedev-container || true
                    docker rm nodedev-container || true

                    docker run -d \
                        --name nodedev-container \
                        --expose 3001 \
                        -p 3001:3000 \
                        muratbekov3/nodedev:v1.0
                '''
            }
        }
    }
}