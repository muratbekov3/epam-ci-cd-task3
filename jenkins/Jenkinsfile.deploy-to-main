pipeline {

    agent any

    stages {

        stage('Pull Image') {
            steps {
                sh 'docker pull muratbekov3/nodemain:v1.0'
            }
        }

        stage('Deploy Main') {
            steps {
                sh '''
                    docker stop nodemain-container 
                    docker rm nodemain-container 

                    docker run -d \
                        --name nodemain-container \
                        --expose 3000 \
                        -p 3000:3000 \
                        muratbekov3/nodemain:v1.0
                '''
            }
        }
    }
}